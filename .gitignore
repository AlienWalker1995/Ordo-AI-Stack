.env
.env.bak
.env.bak.*
.env.compute
secrets/.env.sops.bak
secrets/.env.sops.bak.*
models/
data/

# Rendered runtime + operator-real source (moved from v2/ at the 2026-07-24 flatten).
# out/ holds the rendered .env/docker-compose.yml plus the operator's secrets.env;
# ordo.yaml carries host paths + tailnet identity (this repo is PUBLIC) — only the
# template ordo.example.yaml is tracked.
/out/
/ordo.yaml
.validate-out/
.validate-cpu/

# Secrets / keys (never commit)
*.pem
*.key
*.kubeconfig

# Debug / temporary
comfyui-logs.txt
comfyui*.log
.pytest_cache
pytest-cache-files-*
tmp*
__pycache__
*.pyc

# Local dev (personal notes, full troubleshooting)
context/
.claude/scheduled_tasks.lock
.claude/settings.local.json
cp_test_output.log
test_output.log

# Untracked sibling projects that happen to live in this tree
/isolated_portfolio/

# Hermes Agent (host-mode install + local state; see docs/hermes-agent.md)
vendor/hermes-agent/
data/hermes/

# Tailscale-issued TLS material for Caddy front door — per-host, NEVER commit
auth/caddy/certs/

# Secrets — only encrypted .sops files plus README/.sops.yaml are tracked.
# Any plaintext file someone drops in secrets/ is rejected by default,
# so a slipped `secrets/temp.env` or `secrets/notes.txt` cannot leak.
secrets/*
!secrets/*.sops
!secrets/.sops.yaml
!secrets/README.md
!secrets/.gitkeep

# Internal superpowers tooling artifacts (specs, plans, skill notes) — local only.
docs/superpowers/

# Build/export artifacts and ad-hoc HTML drops accumulated at the repo root
# (min-max blog tarball, page exports). Audit 2026-05-11.
*.tar.gz
/final.html
/index.html

# Local dev artifacts not for the public repo
/screenshots/
/runtime/

# Phase-4 data-staging robocopy log (operator-local build artifact)
.staging.log

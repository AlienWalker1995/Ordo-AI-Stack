# Ensure shell scripts use LF so they run in Linux containers.
# Broader *.sh rule prevents CRLF regressions when new scripts are added
# (e.g. on Windows checkouts with autocrlf=true).
*.sh text eol=lf
services/v1-parity/dashboard/entrypoint.sh text eol=lf
services/hermes/entrypoint.sh text eol=lf
scripts/llamacpp/run-llama-server.sh text eol=lf
# nginx config is COPYed into the codebase-memory-ui image; keep LF so nginx
# doesn't choke on CRLF after a Windows checkout.
services/codebase-memory-ui/nginx.conf text eol=lf

# SOPS-encrypted files must keep LF endings or `sops` chokes parsing the
# embedded timestamp metadata. The failure surfaces as
#   parsing time "2026-XX-XX...Z\x0d": extra text: "\x0d"
# when scripts/secrets/decrypt.sh runs on a Windows-mangled .sops file.
*.sops text eol=lf

# Bind-mounted into Linux containers as an executable (the trainer venv-python
# lease seam) — a CRLF shebang (`python3\r`) breaks exec on Windows checkouts.
assets/* text eol=lf

# YAML manifests are LF always — agents editing from Windows-adjacent runtimes kept
# committing CRLF rewrites that turned 3-line pin bumps into 358-line diffs (PR #154).
# `text eol=lf` makes git normalize on checkin AND checkout, ending the class.
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.py text eol=lf

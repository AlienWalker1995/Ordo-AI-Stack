{
  "uid": "ordo-llm-gpu",
  "title": "Ordo performance",
  "tags": [
    "ordo",
    "llama.cpp",
    "gpu"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU chat generation (tok/s, per request)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 / (sum(rate(litellm_deployment_latency_per_output_token_sum{api_base=\"http://llamacpp:8080/v1\"}[5m])) / sum(rate(litellm_deployment_latency_per_output_token_count{api_base=\"http://llamacpp:8080/v1\"}[5m])))",
          "refId": "A"
        }
      ],
      "description": "Measured at the model gateway (LiteLLM), so it works for any GPU chat engine (llama.cpp or NInfer; NInfer has no /metrics). Per request: output tokens over total latency, so it includes prompt reading."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "CPU fallback generation (tok/s)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "llamacpp:predicted_tokens_seconds{job=\"llamacpp-cpu\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "GPU chat time to first token, p50 (s)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(litellm_llm_api_time_to_first_token_metric_bucket[5m]) * on(model_id) group_left() (max by (model_id) (litellm_deployment_latency_per_output_token_count{api_base=\"http://llamacpp:8080/v1\"}) * 0 + 1)))",
          "refId": "A"
        }
      ],
      "description": "Measured at the model gateway (LiteLLM), so it works for any GPU chat engine."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests in flight",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "litellm_in_flight_requests",
          "legendFormat": "Gateway (all chat)",
          "refId": "A"
        },
        {
          "expr": "llamacpp:requests_processing{job=\"llamacpp-cpu\"}",
          "legendFormat": "CPU fallback",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Chat servers up (GPU drops out while a render has the card)",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "ordo_gpu_chat_up",
          "legendFormat": "GPU chat engine",
          "refId": "A"
        },
        {
          "expr": "up{job=\"llamacpp-cpu\"}",
          "legendFormat": "CPU fallback",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Token throughput (tok/s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "1 / (sum(rate(litellm_deployment_latency_per_output_token_sum{api_base=\"http://llamacpp:8080/v1\"}[5m])) / sum(rate(litellm_deployment_latency_per_output_token_count{api_base=\"http://llamacpp:8080/v1\"}[5m])))",
          "legendFormat": "GPU generation (per request)",
          "refId": "A"
        },
        {
          "expr": "llamacpp:predicted_tokens_seconds{job=\"llamacpp-cpu\"}",
          "legendFormat": "CPU fallback generation",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tokens generated (5m rate)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_output_tokens_metric_total[5m]) * on(model_id) group_left() (max by (model_id) (litellm_deployment_latency_per_output_token_count{api_base=\"http://llamacpp:8080/v1\"}) * 0 + 1))",
          "legendFormat": "GPU (gateway)",
          "refId": "A"
        },
        {
          "expr": "rate(llamacpp:tokens_predicted_total{job=\"llamacpp-cpu\"}[5m])",
          "legendFormat": "CPU fallback",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GPU utilization",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_utilization_gpu_ratio * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GPU VRAM used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_memory_used_bytes * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "GPU temperature (°C)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_temperature_gpu * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GPU power draw (W)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_power_draw_watts * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}

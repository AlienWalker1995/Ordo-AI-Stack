{
  "uid": "ordo-llm-gpu",
  "title": "Ordo performance",
  "tags": [
    "ordo",
    "llama.cpp",
    "gpu"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU output (tok/s, 5m)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_output_tokens_metric_total[5m]) * on(model_id) group_left() (max by (model_id) (litellm_deployment_latency_per_output_token_count{api_base=\"http://inference-engine-gpu:8080/v1\"}) * 0 + 1))",
          "legendFormat": "GPU",
          "refId": "A"
        }
      ],
      "description": "Generated tokens per second on the GPU chat engine, counted at the model gateway when each request finishes (works for NInfer, which has no /metrics). The engine serves one request at a time, so this is also the speed of the request being served, minus the time spent reading its prompt."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GPU prompt reading (tok/s, 5m)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_input_tokens_metric_total[5m]) * on(model_id) group_left() (max by (model_id) (litellm_deployment_latency_per_output_token_count{api_base=\"http://inference-engine-gpu:8080/v1\"}) * 0 + 1))",
          "legendFormat": "GPU",
          "refId": "A"
        }
      ],
      "description": "Prompt tokens per second the GPU reads before it can answer. Agent requests carry ~100k tokens of context, so this is most of the GPU's work."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "GPU request time, median (s)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "noValue": "no requests"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(litellm_llm_api_latency_metric_bucket[15m]) * on(model_id) group_left() (max by (model_id) (litellm_deployment_latency_per_output_token_count{api_base=\"http://inference-engine-gpu:8080/v1\"}) * 0 + 1)))",
          "legendFormat": "GPU",
          "refId": "A"
        }
      ],
      "description": "Median time from the gateway sending a request to the GPU engine until it finishes: waiting in the one-at-a-time queue, reading the prompt and generating the answer."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests in flight",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "litellm_in_flight_requests",
          "legendFormat": "gateway",
          "refId": "A"
        },
        {
          "expr": "llamacpp:requests_deferred{job=\"inference-engine-cpu\"}",
          "legendFormat": "CPU waiting",
          "refId": "B"
        }
      ],
      "description": "Requests the model gateway is handling. The GPU serves one at a time and the rest wait in its first-come-first-served queue (up to 64); the CPU fallback also serves one at a time."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Chat servers up (GPU drops out while a render has the card)",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "ordo_gpu_chat_up",
          "legendFormat": "GPU chat engine",
          "refId": "A"
        },
        {
          "expr": "up{job=\"inference-engine-cpu\"}",
          "legendFormat": "CPU fallback",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Generated tokens per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_output_tokens_metric_total[5m]) * on(model_id) group_left() (max by (model_id) (litellm_deployment_latency_per_output_token_count{api_base=\"http://inference-engine-gpu:8080/v1\"}) * 0 + 1))",
          "legendFormat": "GPU",
          "refId": "A"
        },
        {
          "expr": "rate(llamacpp:tokens_predicted_total{job=\"inference-engine-cpu\"}[5m])",
          "legendFormat": "CPU fallback",
          "refId": "B"
        }
      ],
      "description": "Output tokens per second, 5 minute rate. GPU from the gateway, CPU from llama.cpp."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Prompt tokens read per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(litellm_input_tokens_metric_total[5m]) * on(model_id) group_left() (max by (model_id) (litellm_deployment_latency_per_output_token_count{api_base=\"http://inference-engine-gpu:8080/v1\"}) * 0 + 1))",
          "legendFormat": "GPU",
          "refId": "A"
        },
        {
          "expr": "rate(llamacpp:prompt_tokens_total{job=\"inference-engine-cpu\"}[5m])",
          "legendFormat": "CPU fallback",
          "refId": "B"
        }
      ],
      "description": "Prompt tokens per second, 5 minute rate."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "GPU request time (s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(litellm_llm_api_latency_metric_bucket[15m]) * on(model_id) group_left() (max by (model_id) (litellm_deployment_latency_per_output_token_count{api_base=\"http://inference-engine-gpu:8080/v1\"}) * 0 + 1)))",
          "legendFormat": "median",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(litellm_llm_api_latency_metric_bucket[15m]) * on(model_id) group_left() (max by (model_id) (litellm_deployment_latency_per_output_token_count{api_base=\"http://inference-engine-gpu:8080/v1\"}) * 0 + 1)))",
          "legendFormat": "slowest 5%",
          "refId": "B"
        }
      ],
      "description": "Gateway to GPU engine and back, including the wait in the queue."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "CPU fallbacks per hour",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (exception_class) (increase(litellm_deployment_successful_fallbacks_total{requested_model=\"local-chat\"}[1h]))",
          "legendFormat": "{{exception_class}}",
          "refId": "A"
        },
        {
          "expr": "sum(increase(litellm_deployment_failed_fallbacks_total{requested_model=\"local-chat\"}[1h]))",
          "legendFormat": "fallback failed",
          "refId": "B"
        }
      ],
      "description": "local-chat requests moved to the CPU, by the GPU error that caused it. A busy GPU queue no longer moves a request (it waits its turn), so RateLimitError should stay at zero."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GPU utilization",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_utilization_gpu_ratio * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "GPU VRAM used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_memory_used_bytes * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "GPU temperature (°C)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_temperature_gpu * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "GPU power draw (W)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_power_draw_watts * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}

{
  "uid": "ordo-llm-gpu",
  "title": "Ordo performance",
  "tags": [
    "ordo",
    "engines"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "engine",
        "label": "Engine",
        "type": "query",
        "query": {
          "query": "label_values(ordo_engine_up, engine)",
          "refId": "engines"
        },
        "definition": "label_values(ordo_engine_up, engine)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Model engines (every engine the stack serves, read the engine's own way)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Generated (tok/s, 5m)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      },
      "targets": [
        {
          "expr": "sum by (engine, device) (rate(ordo_engine_output_tokens_total{engine=~\"$engine\"}[5m]))",
          "legendFormat": "{{engine}} ({{device}})",
          "refId": "A"
        }
      ],
      "description": "Tokens generated per second by each engine, 5 minute rate, from the engine itself (llama.cpp's /metrics, or NInfer's request log)."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Prompt computed (tok/s, 5m)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      },
      "targets": [
        {
          "expr": "sum by (engine, device) (rate(ordo_engine_prompt_tokens_processed_total{engine=~\"$engine\"}[5m]))",
          "legendFormat": "{{engine}} ({{device}})",
          "refId": "A"
        }
      ],
      "description": "Prompt tokens each engine actually computed per second. Prefix-cache hits are excluded: they cost the engine almost nothing (see the cache panel)."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Prompt cache reuse (5m)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      },
      "targets": [
        {
          "expr": "sum by (engine, device) (rate(ordo_engine_prompt_tokens_cached_total{engine=~\"$engine\"}[5m])) / (sum by (engine, device) (rate(ordo_engine_prompt_tokens_cached_total{engine=~\"$engine\"}[5m])) + sum by (engine, device) (rate(ordo_engine_prompt_tokens_processed_total{engine=~\"$engine\"}[5m])))",
          "legendFormat": "{{engine}} ({{device}})",
          "refId": "A"
        }
      ],
      "description": "Share of prompt tokens served from the engine's prefix cache. High is good: those tokens are not recomputed."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Waiting for the engine",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      },
      "targets": [
        {
          "expr": "sum by (engine, device) (ordo_engine_requests_waiting{engine=~\"$engine\"})",
          "legendFormat": "{{engine}} ({{device}})",
          "refId": "A"
        }
      ],
      "description": "Requests queued for each engine right now. Engines serve one request at a time, first come first served, so a queue here is the wait, not a slow model."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Engine up",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "max by (engine, device) (ordo_engine_up{engine=~\"$engine\"})",
          "legendFormat": "{{engine}} ({{device}})",
          "refId": "A"
        }
      ],
      "description": "1 while ops-controller can read the engine and it is running. A GPU engine drops to 0 while a render has borrowed its card."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Generated tokens per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (engine, device) (rate(ordo_engine_output_tokens_total{engine=~\"$engine\"}[5m]))",
          "legendFormat": "{{engine}} ({{device}})",
          "refId": "A"
        }
      ],
      "description": "Output tokens per second, 5 minute rate."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Prompt tokens computed per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (engine, device) (rate(ordo_engine_prompt_tokens_processed_total{engine=~\"$engine\"}[5m]))",
          "legendFormat": "{{engine}} ({{device}})",
          "refId": "A"
        }
      ],
      "description": "Prompt tokens computed per second (cache hits excluded), 5 minute rate."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Generation speed while generating",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (engine, device) (rate(ordo_engine_output_tokens_total{engine=~\"$engine\"}[5m])) / sum by (engine, device) (rate(ordo_engine_output_seconds_total{engine=~\"$engine\"}[5m]))",
          "legendFormat": "{{engine}} ({{device}})",
          "refId": "A"
        }
      ],
      "description": "Tokens per second during generation only (output tokens over time spent generating): the model's speed, independent of how busy it is."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Prompt speed while computing prompts",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (engine, device) (rate(ordo_engine_prompt_tokens_processed_total{engine=~\"$engine\"}[5m])) / sum by (engine, device) (rate(ordo_engine_prompt_seconds_total{engine=~\"$engine\"}[5m]))",
          "legendFormat": "{{engine}} ({{device}})",
          "refId": "A"
        }
      ],
      "description": "Prompt tokens per second while computing prompts (computed tokens over time spent on them)."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests running and waiting",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (engine, device) (ordo_engine_requests_running{engine=~\"$engine\"})",
          "legendFormat": "{{engine}} running",
          "refId": "A"
        },
        {
          "expr": "sum by (engine, device) (ordo_engine_requests_waiting{engine=~\"$engine\"})",
          "legendFormat": "{{engine}} waiting",
          "refId": "B"
        }
      ],
      "description": "Requests each engine is working on and the queue behind it."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Prompt cache reuse",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (engine, device) (rate(ordo_engine_prompt_tokens_cached_total{engine=~\"$engine\"}[5m])) / (sum by (engine, device) (rate(ordo_engine_prompt_tokens_cached_total{engine=~\"$engine\"}[5m])) + sum by (engine, device) (rate(ordo_engine_prompt_tokens_processed_total{engine=~\"$engine\"}[5m])))",
          "legendFormat": "{{engine}} ({{device}})",
          "refId": "A"
        }
      ],
      "description": "Share of prompt tokens served from the prefix cache, 5 minute rate."
    },
    {
      "id": 101,
      "type": "row",
      "title": "Model gateway",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Fallbacks per hour",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (exception_class) (increase(litellm_deployment_successful_fallbacks_total[1h]))",
          "legendFormat": "{{exception_class}}",
          "refId": "A"
        },
        {
          "expr": "sum(increase(litellm_deployment_failed_fallbacks_total[1h]))",
          "legendFormat": "fallback failed",
          "refId": "B"
        }
      ],
      "description": "Requests the model gateway moved to a fallback model, by the error that moved them. A busy queue does not move requests: only an engine error does."
    },
    {
      "id": 102,
      "type": "row",
      "title": "GPUs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GPU utilization",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "nvidia_smi_utilization_gpu_ratio * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "description": "Compute utilization per GPU."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "GPU VRAM used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "nvidia_smi_memory_used_bytes * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "description": "VRAM in use per GPU."
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "GPU temperature (°C)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "nvidia_smi_temperature_gpu * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "description": "Temperature per GPU."
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "GPU power draw (W)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 0,
          "custom": {
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "nvidia_smi_power_draw_watts * on(uuid) group_left(name) nvidia_smi_gpu_info",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "description": "Power draw per GPU."
    }
  ]
}

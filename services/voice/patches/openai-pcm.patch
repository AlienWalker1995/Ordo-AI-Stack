         media_type = f"audio/{request.response_format}"
+        response_headers = {}
+        if is_pcm:
+            media_type = f"audio/pcm;rate={engine_sr}"
+            response_headers["X-Audio-Sample-Rate"] = str(engine_sr)
 
         # Optional: Save to disk if enabled
         if config_manager.get_bool("audio_output.save_to_disk", False):
@@ -1537,7 +1545,8 @@ async def openai_speech_endpoint(request: OpenAISpeechRequest):

    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "27.4.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vite": "^5.4.11",
    "vitest": "3.2.7"

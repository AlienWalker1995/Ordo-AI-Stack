{
  "name": "ordo-dashboard-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "React port of the Ordo dashboard SPA (consumes the existing FastAPI /api/* backend).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",

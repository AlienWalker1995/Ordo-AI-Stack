+    def _is_reply_to_self(self, message: Any) -> bool:
+        """True when ``message`` quote-replies a message this bot sent. Discord ships the
+        referenced message in the MESSAGE_CREATE payload (``reference.resolved``); when it is
+        missing or deleted the author is unknown and this returns False."""
+        if not self._client or not self._client.user:
+            return False
+        referenced = getattr(getattr(message, "reference", None), "resolved", None)
+        author = getattr(referenced, "author", None)
+        return author is not None and getattr(author, "id", None) == self._client.user.id
+

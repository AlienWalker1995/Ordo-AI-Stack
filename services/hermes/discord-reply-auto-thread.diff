+@pytest.mark.asyncio
+async def test_discord_reply_to_own_message_still_auto_threads(adapter, monkeypatch):
+    """A mention sent as a quote-reply to a human's message is a new request: it gets a thread."""
+    monkeypatch.setenv("DISCORD_REQUIRE_MENTION", "true")
+    monkeypatch.delenv("DISCORD_FREE_RESPONSE_CHANNELS", raising=False)
+    monkeypatch.delenv("DISCORD_AUTO_THREAD", raising=False)  # default true
+
+    adapter._auto_create_thread = AsyncMock(return_value=FakeThread(channel_id=456, name="t"))
+    message = make_message(
+        channel=FakeTextChannel(channel_id=123),
+        content="<@999> what is this bottle?",
+        mentions=[adapter._client.user],
+        msg_type=discord_platform.discord.MessageType.reply,
+    )
+    human = SimpleNamespace(id=42, display_name="Jezza", name="Jezza")
+    message.reference = SimpleNamespace(message_id=77, resolved=SimpleNamespace(id=77, author=human))
+
+    await adapter._handle_message(message)
+
+    adapter._auto_create_thread.assert_awaited_once_with(message)
+    assert adapter.handle_message.await_args.args[0].source.chat_type == "thread"
+
+
+@pytest.mark.asyncio
+async def test_discord_reply_to_bot_message_stays_inline(adapter, monkeypatch):
+    """Quote-replying the bot's own in-channel answer continues that exchange inline."""
+    monkeypatch.setenv("DISCORD_REQUIRE_MENTION", "true")
+    monkeypatch.delenv("DISCORD_FREE_RESPONSE_CHANNELS", raising=False)
+    monkeypatch.delenv("DISCORD_AUTO_THREAD", raising=False)  # default true
+
+    adapter._auto_create_thread = AsyncMock()
+    message = make_message(
+        channel=FakeTextChannel(channel_id=123),
+        content="<@999> and the second one?",
+        mentions=[adapter._client.user],
+        msg_type=discord_platform.discord.MessageType.reply,
+    )
+    message.reference = SimpleNamespace(
+        message_id=88, resolved=SimpleNamespace(id=88, author=adapter._client.user),
+    )
+
+    await adapter._handle_message(message)
+
+    adapter._auto_create_thread.assert_not_awaited()
+    assert adapter.handle_message.await_args.args[0].source.chat_type == "group"
+
+

+
+
+class TestDefaultHostFromEnvironment:
+    """The local default follows COMFYUI_URL so a gated deployment cannot be bypassed."""
+
+    def _reload(self, monkeypatch, value):
+        if value is None:
+            monkeypatch.delenv("COMFYUI_URL", raising=False)
+        else:
+            monkeypatch.setenv("COMFYUI_URL", value)
+        return importlib.reload(_common).DEFAULT_LOCAL_HOST
+
+    def test_follows_comfyui_url(self, monkeypatch):
+        try:
+            assert self._reload(monkeypatch, "http://gate:8188") == "http://gate:8188"
+        finally:
+            monkeypatch.undo()
+            importlib.reload(_common)
+
+    def test_falls_back_to_stock_local_when_unset(self, monkeypatch):
+        try:
+            assert self._reload(monkeypatch, None) == "http://127.0.0.1:8188"
+        finally:
+            monkeypatch.undo()
+            importlib.reload(_common)
+
+    def test_empty_value_is_treated_as_unset(self, monkeypatch):
+        try:
+            assert self._reload(monkeypatch, "") == "http://127.0.0.1:8188"
+        finally:
+            monkeypatch.undo()
+            importlib.reload(_common)

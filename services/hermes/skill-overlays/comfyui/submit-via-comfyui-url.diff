@@ -40,7 +40,12 @@ except ImportError:  # pragma: no cover - exercised via stdlib fallback
 # Constants & catalogs
 # =============================================================================
 
-DEFAULT_LOCAL_HOST = "http://127.0.0.1:8188"
+# Where local work is submitted. A deployment that fronts ComfyUI with an admission
+# gate (for example one that must take a GPU lease before a render starts) publishes the
+# gate's address as COMFYUI_URL, and every script here must use it: submitting straight
+# to the engine skips the lease and lets a render share the GPU with whatever the gate
+# would have evicted. Unset falls back to the stock local address.
+DEFAULT_LOCAL_HOST = os.environ.get("COMFYUI_URL") or "http://127.0.0.1:8188"
 DEFAULT_CLOUD_HOST = "https://cloud.comfy.org"
 ENV_API_KEY = "COMFY_CLOUD_API_KEY"
 

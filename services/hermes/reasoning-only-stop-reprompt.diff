+
+
+def test_promotion_off_switch_reprompts_instead_of_returning_reasoning(loop_agent, monkeypatch):
+    """HERMES_PROMOTE_REASONING_ONLY_STOP=0: an empty-content stop is the model quitting inside its
+    thinking, so the ladder re-asks and the real answer is returned, never the monologue."""
+    from tests.agent.test_run_agent import _mock_response
+
+    monkeypatch.setenv("HERMES_PROMOTE_REASONING_ONLY_STOP", "0")
+    monologue = "The user wants images of themselves. Hmm, but generating a specific person is tricky. Let me"
+
+    result = _run(loop_agent, [
+        _mock_response(content="", finish_reason="stop", reasoning_content=monologue),
+        _mock_response(content="Here are the two images.", finish_reason="stop"),
+    ])
+
+    assert result["api_calls"] == 2
+    assert result["final_response"] == "Here are the two images."

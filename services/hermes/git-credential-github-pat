#!/bin/sh
# git credential helper for github.com: answers `get` with the backup-repo PAT, read from its
# file secret at the moment git asks. The token is never written to a git config, a remote URL,
# or a command line, and a rotated secret (`ordo secrets set GITHUB_BACKUP_PAT`, then `ordo apply`)
# takes effect without touching any repo. Wired for https://github.com by `git config --system`
# in the Dockerfile. `store` and `erase` are ignored: there is nothing to cache.
set -eu
[ "${1:-}" = "get" ] || exit 0
token_file="${GITHUB_BACKUP_PAT_FILE:-/run/secrets/github_backup_pat}"
# No token, no answer: git then fails with its own clear authentication error.
[ -s "$token_file" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$(cat "$token_file")"

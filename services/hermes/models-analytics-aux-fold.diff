diff --git a/tests/hermes_state/test_aux_usage_accounting.py b/tests/hermes_state/test_aux_usage_accounting.py
index d960e0d78d..2a2fd0792c 100644
--- a/tests/hermes_state/test_aux_usage_accounting.py
+++ b/tests/hermes_state/test_aux_usage_accounting.py
@@ -292,3 +292,34 @@ class TestInsightsAuxTotals:
         models = {m["model"] for m in report["models"]}
         assert {"main-model", "glm-5"} <= models
 
+
+class TestModelsAnalyticsAuxFold:
+    def test_aux_usage_of_a_session_model_folds_into_its_row(self, db, monkeypatch):
+        """One model, many aux tasks under different provider strings: the Models page shows ONE
+        card for it (aux tokens added, sessions not double-counted). A model used only by aux
+        tasks still gets exactly one card of its own."""
+        from hermes_cli.web_routers import analytics
+
+        db.create_session("s1", source="cli")
+        db.update_token_counts("s1", input_tokens=1000, output_tokens=100,
+                               model="local-chat", billing_provider="custom", api_call_count=1)
+        for task, provider in (("compression", "auto"), ("title_generation", ""), ("approval", "custom")):
+            db.record_auxiliary_usage("s1", task, model="local-chat", billing_provider=provider,
+                                      input_tokens=10, output_tokens=1)
+        db.record_auxiliary_usage("s1", "vision", model="vision-model", billing_provider="gemini",
+                                  input_tokens=300, output_tokens=30)
+        db.record_auxiliary_usage("s1", "compression", model="vision-model", billing_provider="auto",
+                                  input_tokens=5, output_tokens=1)
+        monkeypatch.setattr(analytics, "_open_session_db_for_profile", lambda profile, read_only=True: db)
+        monkeypatch.setattr(db, "close", lambda: None)
+
+        models = analytics._get_models_analytics(days=30)["models"]
+        by_name = {}
+        for m in models:
+            by_name.setdefault(m["model"], []).append(m)
+        assert sorted((name, len(rows)) for name, rows in by_name.items()) == [("local-chat", 1), ("vision-model", 1)]
+        chat = by_name["local-chat"][0]
+        assert chat["provider"] == "custom"
+        assert chat["input_tokens"] == 1030 and chat["output_tokens"] == 103
+        assert chat["sessions"] == 1
+        assert by_name["vision-model"][0]["input_tokens"] == 305

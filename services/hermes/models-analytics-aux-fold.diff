+def _fold_aux_usage_by_model(rows: List[Dict[str, Any]], aux_rows: List[Dict[str, Any]]) -> None:
+    """Add aux usage (titles, compression, vision, ...) to the Models page rows, by model name.
+
+    The aux path records whatever provider string it resolved (``auto``, ``custom``, empty), so
+    keying aux rows by (model, provider) showed one model as many unlabeled cards. Aux usage of a
+    model that has session rows is added to that model's busiest row (aux calls happen inside
+    those sessions, so ``sessions`` is not added again). A model used only by aux tasks gets one
+    row of its own (#23270)."""
+    session_row_by_model: Dict[str, Dict[str, Any]] = {}
+    for row in rows:  # rows are not sorted yet: keep the one with the most tokens per model
+        model = row.get("model") or ""
+        best = session_row_by_model.get(model)
+        if best is None or _token_volume(row) > _token_volume(best):
+            session_row_by_model[model] = row
+    aux_only: Dict[str, Dict[str, Any]] = {}
+    for aux in aux_rows:
+        model = aux.get("model") or "unknown"
+        target = session_row_by_model.get(model)
+        if target is None:
+            target = aux_only.setdefault(model, {
+                "model": model, "billing_provider": aux.get("billing_provider") or "",
+                **{key: 0 for key in _AUX_SUMMED_KEYS},
+                "actual_cost": 0, "tool_calls": 0, "last_used_at": None, "avg_tokens_per_session": 0,
+            })
+            target["sessions"] = max(target["sessions"], aux.get("sessions") or 0)
+        for key in _AUX_SUMMED_KEYS:
+            if key != "sessions":
+                target[key] = (target.get(key) or 0) + (aux.get(key) or 0)
+        target["last_used_at"] = max(target.get("last_used_at") or 0, aux.get("last_used_at") or 0) or None
+    rows.extend(aux_only.values())
+

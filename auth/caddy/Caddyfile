{
    # Listen only on the interface compose gives us; the bind address is
    # controlled at compose level via CADDY_BIND.
    auto_https off
}

# Plain-HTTP healthz on :80 for the in-container Docker healthcheck
# (caddy:2-alpine's wget targets http://localhost/healthz). Every HTTPS
# site below also serves /healthz for tailnet probes.
:80 {
    handle /healthz {
        respond "ok" 200
    }
    handle {
        respond "use https" 421
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# PORT-PER-SERVICE MODEL (2026-07-24). Every UI service gets its own dedicated
# SSO-gated HTTPS port on the tailnet hostname. Rationale: subpath mounting
# repeatedly fought prebuilt SPAs with baked root-absolute bases — Open WebUI
# hard-404s under a prefix (client-side router; proven with a real browser on
# v0.10.1), Hermes needed header-driven base injection, n8n needed strip_prefix
# surgery, codebase-memory needed nginx rewrites. Ports end that problem class:
# each app is served at the root it was built for.
#
#   :443   front door — landing page, /oauth2 (the ONE Google callback),
#          /llm + /mcp API routes, n8n webhook/OAuth passthroughs, and 302s
#          from every legacy subpath so old bookmarks keep working.
#   :8443  Open WebUI (chat)        :8444  Dashboard (+ /grafana/ embed)
#   :8445  n8n                      :8446  ComfyUI
#   :8447  Hermes                   :8448  codebase-memory
#
# SSO works across all ports (and the per-service Tailscale sidecar names —
# chat/dash/… .<tailnet>.ts.net) with ONE session: the oauth2-proxy cookie is
# domain-scoped (port-agnostic), the OAuth callback stays on :443, and the
# shared gate builds rd= with {host} — see the (sso_forward_auth) note below
# for why {host}, not {hostport}.
# ─────────────────────────────────────────────────────────────────────────────

# Shared TLS material (Tailscale-issued cert, mounted in by the host).
(tls_tailnet) {
    tls /etc/caddy/certs/tailnet.crt /etc/caddy/certs/tailnet.key
}

# Shared SSO gate for a dedicated service port.
(sso_port_gate) {
    handle /oauth2/* {
        reverse_proxy oauth2-proxy:4180
    }
    handle /healthz {
        respond "ok" 200
    }
}
# rd= uses {host} (portless), NOT {hostport}. The per-service Tailscale sidecar
# nodes (chat/dash/… .<tailnet>.ts.net) `serve`-forward their clean Host with no
# port, so the gate MUST match on the portless host — {hostport} would emit a
# bogus chat.<tailnet>:8443 rd and break the sidecar sign-in. Cost: a first
# sign-in via a bare :844x port lands on the :443 hub instead of returning to
# the port; the domain-scoped cookie then covers every port + name, so it's a
# one-time extra click, not a broken flow.
(sso_forward_auth) {
    forward_auth oauth2-proxy:4180 {
        uri /oauth2/auth
        copy_headers X-Auth-Request-Email>X-Forwarded-Email X-Auth-Request-User>X-Forwarded-User X-Auth-Request-Preferred-Username>X-Forwarded-Preferred-Username
        @unauthorized status 401
        handle_response @unauthorized {
            redir https://{host}/oauth2/start?rd={scheme}://{host}{uri} 302
        }
    }
}
# The whole site for a simple ported service: TLS + SSO + proxy-everything.
(sso_service) {
    import tls_tailnet
    import sso_port_gate
    route {
        import sso_forward_auth
        reverse_proxy {args[0]}
    }
}

# ---- :8443 — Open WebUI (chat) ----
# Prebuilt SvelteKit SPA with base="" (root-absolute /_app, /static, /api, /ws).
# It MUST be served at a root — under /chat/ its client-side router renders
# "404: Not Found" (browser-verified on v0.10.1, same as v0.9.2). A port root
# is a root, so it gets one.
:8443 {
    import sso_service open-webui:8080
}

# ---- :8444 — Dashboard (operator hub) + Grafana embed ----
# Grafana rides this port at /grafana/ (GF_SERVER_SERVE_FROM_SUB_PATH +
# root_url /grafana/) so the dashboard's Grafana tab keeps its same-origin
# iframe. `handle` (NOT handle_path) keeps the prefix Grafana expects.
:8444 {
    import tls_tailnet
    import sso_port_gate
    route {
        import sso_forward_auth
        handle /grafana/* {
            reverse_proxy grafana:3000
        }
        reverse_proxy dashboard:8080
    }
}

# ---- :8445 — n8n ----
# Served at root: N8N_PATH=/ tells n8n to emit root-absolute asset URLs, so a plain
# pass-through proxy works with no prefix surgery. n8n's EXTERNAL public base
# (N8N_WEBHOOK_URL, OAuth callbacks) still lives at :443/n8n/* — those passthroughs
# below strip /n8n and are unchanged.
:8445 {
    import sso_service n8n:5678
}

# ---- :8446 — ComfyUI ----
:8446 {
    import sso_service comfyui:8188
}

# ---- :8447 — Hermes ----
# Served at its origin root behind a plain SSO proxy — no prefix strip, no
# forwarded-prefix header base injection.
:8447 {
    import sso_service hermes-dashboard:9119
}

# ---- :8448 — codebase-memory 3D graph ----
# Served at its origin root behind a plain SSO proxy — the container's nginx
# proxies straight through with no path rewriting (see codebase-memory-ui/nginx.conf).
:8448 {
    import sso_service codebase-memory-ui:9750
}

# ─────────────────────────────────────────────────────────────────────────────
# :443 — the front door. OAuth callback, API routes, external passthroughs,
# the landing page, and legacy-path redirects. No UI app lives here anymore.
# ─────────────────────────────────────────────────────────────────────────────
{$CADDY_TAILNET_HOSTNAME} {
    import tls_tailnet

    # ---- public bypass routes (auth not required) ----
    handle /oauth2/* {
        reverse_proxy oauth2-proxy:4180
    }
    handle /healthz {
        respond "ok" 200
    }
    # External services (Google OAuth for n8n credentials, IG Graph webhooks…)
    # hit these registered URLs — they MUST stay on :443 and MUST keep working.
    # strip_prefix because n8n's internal routes live at /rest/... and
    # /webhook/..., not /n8n/rest/... (verified live 2026-05-18).
    handle /n8n/rest/oauth2-credential/callback* {
        uri strip_prefix /n8n
        reverse_proxy n8n:5678
    }
    handle /n8n/webhook/* {
        uri strip_prefix /n8n
        reverse_proxy n8n:5678
    }

    # ---- LiteLLM model gateway (OpenAI-compatible API) for tailnet API clients ----
    # Bypasses SSO: programmatic clients (Cline, Cursor, scripts) can't do an
    # interactive Google login. Auth is LiteLLM's own Bearer key
    # (LITELLM_MASTER_KEY), which model-gateway enforces.
    handle_path /llm/* {
        reverse_proxy model-gateway:11435
    }

    # ---- MCP gateway (aggregated tools) for tailnet MCP clients ----
    # Bypasses Google SSO but requires a static Bearer (MCP_GATEWAY_TOKEN)
    # because the gateway has NO auth of its own. Unstripped — the gateway
    # serves at /mcp. flush_interval -1 keeps SSE unbuffered.
    @mcp_unauthed {
        path /mcp /mcp/*
        not header Authorization "Bearer {$MCP_GATEWAY_TOKEN}"
    }
    @mcp path /mcp /mcp/*
    handle @mcp_unauthed {
        respond "Unauthorized" 401
    }
    handle @mcp {
        reverse_proxy mcp-gateway:8811 {
            flush_interval -1
        }
    }

    # ---- legacy-path 302s (no auth needed for a redirect) ----
    # Every pre-port bookmark keeps working. Deep chat/app paths are session
    # state, not stable URLs — landing on the service root is correct.
    redir /chat* https://{host}:8443/ 302
    redir /dash* https://{host}:8444/ 302
    redir /comfy* https://{host}:8446/ 302
    redir /hermes* https://{host}:8447/ 302
    redir /codebase-memory* https://{host}:8448/ 302
    redir /grafana* https://{host}:8444/grafana/ 302
    # /n8n UI → its port. NB: Caddy sorts `redir` BEFORE `handle` regardless of file
    # order, so a bare `redir /n8n*` would shadow the webhook/OAuth passthrough handles
    # above (verified live 2026-07-24: /n8n/webhook/* 302'd instead of proxying). The
    # matcher must therefore exclude the external-facing paths explicitly.
    @n8n_ui {
        path /n8n /n8n/*
        not path /n8n/webhook/* /n8n/rest/oauth2-credential/callback*
    }
    redir @n8n_ui https://{host}:8445/ 302

    # ---- landing page + everything else (SSO-gated) ----
    route {
        import sso_forward_auth
        handle / {
            header Content-Type "text/html; charset=utf-8"
            respond <<HTML
                <!doctype html><html lang="en"><head><meta charset="utf-8">
                <meta name="viewport" content="width=device-width,initial-scale=1">
                <title>Ordo</title><style>
                body{background:#0d0d0f;color:#e8e8ea;font:16px/1.6 system-ui,sans-serif;
                     display:grid;place-items:center;min-height:100vh;margin:0}
                main{max-width:640px;padding:2rem}
                h1{font-weight:600;letter-spacing:.02em;margin:0 0 .25rem}
                h1 span{color:#e5484d}
                p{color:#9a9aa0;margin:.25rem 0 1.5rem}
                ul{list-style:none;padding:0;margin:0;display:grid;gap:.5rem;
                   grid-template-columns:repeat(auto-fill,minmax(180px,1fr))}
                a{display:block;padding:.8rem 1rem;background:#17171a;border:1px solid #26262b;
                  border-radius:10px;color:#e8e8ea;text-decoration:none}
                a:hover{border-color:#e5484d}
                a small{display:block;color:#7a7a80;font-size:.78rem}
                </style></head><body><main>
                <h1>Ordo<span>.</span></h1>
                <p>One sign-in, one port per service.</p>
                <ul>
                <li><a href="https://{host}:8443/">Chat<small>Open WebUI · :8443</small></a></li>
                <li><a href="https://{host}:8444/">Dashboard<small>control hub · :8444</small></a></li>
                <li><a href="https://{host}:8447/">Hermes<small>agent · :8447</small></a></li>
                <li><a href="https://{host}:8446/">ComfyUI<small>media · :8446</small></a></li>
                <li><a href="https://{host}:8445/">n8n<small>automation · :8445</small></a></li>
                <li><a href="https://{host}:8448/">Code graph<small>memory · :8448</small></a></li>
                </ul></main></body></html>
                HTML
        }
        handle {
            respond "not found" 404
        }
    }
}
